rules_version = '2';

// 벨라모나 Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여 넣고 "게시"를 누른다.
//
// 원칙: 내 기록은 나만 읽고 쓴다. 친구는 내 이름/아이콘과 루틴 체크(달성률, 연속 기록일)만 볼 수 있다.
// 관리자 계정은 읽기만 가능하다. 'ADMIN_EMAIL' 자리에 관리자 구글 이메일을 넣는다(bellamona.net/admin 화면에서 채워진 규칙을 복사할 수 있음).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 관리자(/admin 화면): 아래 목록의 구글 계정만. 모든 사용자의 기록을 읽기만 할 수 있다(쓰기 불가).
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['ADMIN_EMAIL'];
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // uid의 친구 목록에 내가 들어 있으면 친구로 본다(친구 추가는 양방향으로 저장됨)
    function isFriendOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    match /users/{uid} {
      // 이름, 아이콘, 친구 코드만 들어 있는 문서
      allow read: if isAdmin() || isOwner(uid) || isFriendOf(uid);
      allow list: if isAdmin();
      allow create, update, delete: if isOwner(uid);

      // 관리자는 모든 하위 기록을 읽을 수 있다(관리자 화면은 개수와 날짜만 보여 준다)
      match /{document=**} {
        allow read: if isAdmin();
      }

      // 친구 목록: 내가 상대를 추가하면 상대 목록에도 내가 들어간다.
      // 상대 목록에 나를 넣을 때는 상대의 친구 코드를 실제로 알고 있어야 한다(via_code).
      match /friends/{fid} {
        allow read, write: if isOwner(uid);
        allow get: if signedIn() && request.auth.uid == fid;
        allow create, update: if signedIn() && request.auth.uid == fid
          && request.resource.data.via_code == get(/databases/$(database)/documents/users/$(uid)).data.friend_code;
        allow delete: if signedIn() && request.auth.uid == fid; // 탈퇴할 때 상대 목록에서 나를 지움
      }

      // 루틴 체크는 친구도 읽을 수 있다(친구 비교 화면)
      match /routine_checks/{date} {
        allow read: if isOwner(uid) || isFriendOf(uid);
        allow write: if isOwner(uid);
      }

      // 그 밖의 모든 기록(식사, 운동, 수면, 체중, 생리주기, 일기, 리포트, 프로필)은 본인만
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 친구 코드 → 사용자 찾기. 코드를 정확히 알 때만 한 건씩 조회 가능(목록 조회 불가)
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
